<.header>
  Listing Dashboards
  <:actions>
    <.link patch={~p"/dashboards/new"}>
      <.button>New Dashboard</.button>
    </.link>
  </:actions>
</.header>

<!-- Status Filter -->
<div class="mb-6 p-4 bg-gray-50 rounded-lg border">
  <form phx-change="filter" class="flex items-center space-x-4">
    <label class="text-sm font-medium text-gray-700">Filter by Status:</label>
    <select name="status" class="px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
      <option value="">All Dashboards</option>
      <option value="active" selected={@filter_status == "active"}>Active Only</option>
      <option value="inactive" selected={@filter_status == "inactive"}>Inactive Only</option>
    </select>
  </form>
</div>

<.table
  id="dashboards"
  rows={@streams.dashboards}
  row_click={fn {_id, dashboard} -> JS.navigate(~p"/dashboards/#{dashboard}") end}
>
  <:col :let={{_id, dashboard}} label="Title">{dashboard.title}</:col>
  <:col :let={{_id, dashboard}} label="Description">{dashboard.description}</:col>
  <:col :let={{_id, dashboard}} label="Status">
    <span class={[
      "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium",
      (if dashboard.status == "active", do: "bg-green-100 text-green-800", else: "bg-red-100 text-red-800")
    ]}>
      <%= String.capitalize(dashboard.status) %>
    </span>
  </:col>
  <:action :let={{_id, dashboard}}>
    <div class="sr-only">
      <.link navigate={~p"/dashboards/#{dashboard}"}>Show</.link>
    </div>
    <.link patch={~p"/dashboards/#{dashboard}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, dashboard}}>
    <.link
      phx-click={JS.push("delete", value: %{id: dashboard.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

<!-- Custom Pagination with Filter Preservation -->
<div :if={@pagination.total_pages > 1} class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6">
  <div class="flex flex-1 justify-between sm:hidden">
    <.link
      :if={@pagination.page_number > 1}
      patch={"/dashboards?page=#{@pagination.page_number - 1}#{if @filter_status, do: "&status=#{@filter_status}", else: ""}"}
      class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
    >
      Previous
    </.link>
    <.link
      :if={@pagination.page_number < @pagination.total_pages}
      patch={"/dashboards?page=#{@pagination.page_number + 1}#{if @filter_status, do: "&status=#{@filter_status}", else: ""}"}
      class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
    >
      Next
    </.link>
  </div>
  <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
    <div>
      <p class="text-sm text-gray-700">
        Showing <span class="font-medium"><%= (@pagination.page_number - 1) * @pagination.page_size + 1 %></span> to <span class="font-medium"><%= min(@pagination.page_number * @pagination.page_size, @pagination.total_entries) %></span> of <span class="font-medium"><%= @pagination.total_entries %></span> results
      </p>
    </div>
    <div>
      <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
        <.link
          :if={@pagination.page_number > 1}
          patch={"/dashboards?page=#{@pagination.page_number - 1}#{if @filter_status, do: "&status=#{@filter_status}", else: ""}"}
          class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0"
        >
          <span class="sr-only">Previous</span>
          <.icon name="hero-chevron-left-mini" class="h-5 w-5" />
        </.link>

        <%= for page_num <- max(1, @pagination.page_number - 2)..min(@pagination.total_pages, @pagination.page_number + 2) do %>
          <.link
            patch={"/dashboards?page=#{page_num}#{if @filter_status, do: "&status=#{@filter_status}", else: ""}"}
            class={[
              "relative inline-flex items-center px-4 py-2 text-sm font-semibold",
              if(page_num == @pagination.page_number,
                do: "z-10 bg-indigo-600 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600",
                else: "text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0"
              )
            ]}
          >
            <%= page_num %>
          </.link>
        <% end %>

        <.link
          :if={@pagination.page_number < @pagination.total_pages}
          patch={"/dashboards?page=#{@pagination.page_number + 1}#{if @filter_status, do: "&status=#{@filter_status}", else: ""}"}
          class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0"
        >
          <span class="sr-only">Next</span>
          <.icon name="hero-chevron-right-mini" class="h-5 w-5" />
        </.link>
      </nav>
    </div>
  </div>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="dashboard-modal"
  show
  on_cancel={JS.patch(~p"/dashboards")}
>
  <.live_component
    module={MyProjectWeb.DashboardLive.FormComponent}
    id={@dashboard.id || :new}
    title={@page_title}
    action={@live_action}
    dashboard={@dashboard}
    patch={~p"/dashboards"}
  />
</.modal>
